# ===== Server =====
PORT=3000
MONGO_URI=mongodb://localhost:27017/biomexa
JWT_SECRET=change-this-to-a-long-random-string

# ===== WhatsApp — free option (CallMeBot) =====
# 1. Save +34 644 52 53 53 to your contacts on the phone you want to send FROM.
# 2. WhatsApp that number the text: "I allow callmebot to send me messages"
# 3. CallMeBot replies with your personal API key — put it below.
# This key sends messages, it does not receive replies from patients.
CALLMEBOT_API_KEY=

# ===== WhatsApp — paid fallback (Twilio) =====
# Optional. If set, used automatically when CallMeBot fails or isn't configured.
# Requires a Twilio account with the WhatsApp Business API / Sandbox enabled.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE=
