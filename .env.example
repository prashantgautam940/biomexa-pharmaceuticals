# ===== Server =====
PORT=3000
MONGO_URI=mongodb://localhost:27017/biomexa
JWT_SECRET=change-this-to-a-long-random-string

# ===== WhatsApp — free option (CallMeBot) =====
# IMPORTANT: a CallMeBot key only works for the ONE phone number that generated it — it
# CANNOT send to arbitrary patients. Every patient and doctor now enters their own key
# during signup (or later, from their dashboard's "Connect WhatsApp" panel), and that's
# what's actually used to message them.
#
# The single key below is just a fallback for one admin/testing number — it will NOT make
# reminders work for your real patients. To test it for yourself:
# 1. Save +34 644 52 53 53 to your contacts on the phone you want to send FROM.
# 2. WhatsApp that number the text: "I allow callmebot to send me messages"
# 3. CallMeBot replies with your personal API key — put it below.
CALLMEBOT_API_KEY=

# ===== WhatsApp — paid fallback (Twilio) =====
# Optional. If set, used automatically when CallMeBot fails or isn't configured.
# Requires a Twilio account with the WhatsApp Business API / Sandbox enabled.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE=

# ===== Admin Panel (admin.html) =====
# Protects /api/admin/* — patient data, CSV export, and the AI training endpoint.
# CHANGE THESE before deploying — the values below are only placeholders.
# If left unset, the server falls back to biomexadmin / BiomexaAdmin@2026, which is
# public in this file, so do not rely on the fallback in production.
ADMIN_USERNAME=biomexadmin
ADMIN_PASSWORD=change-this-to-a-strong-password

# ===== Email fallback for password reset (Gmail SMTP) =====
# Optional but recommended — WhatsApp reset codes only reach patients/doctors who've
# connected their own CallMeBot key (see CALLMEBOT_API_KEY note above). Email works for
# anyone with an email on file, so it's the reliable fallback.
# 1. Use a Gmail account (e.g. biomexapharmaceuticals@gmail.com).
# 2. Turn on 2-Step Verification: https://myaccount.google.com/security
# 3. Generate an App Password: https://myaccount.google.com/apppasswords
#    (NOT your normal Gmail password — Google blocks that for security.)
EMAIL_USER=
EMAIL_APP_PASSWORD=
