# ===== Server =====
PORT=3000
MONGO_URI=mongodb://localhost:27017/biomexa
JWT_SECRET=change-this-to-a-long-random-string

# ===== Admin Panel (admin.html) =====
# Protects /api/admin/* — patient data, CSV export, and the AI training endpoint.
# These three values are only used ONCE, to auto-create the real admin account in the database
# the first time the server ever starts up with an empty Admin collection. After that first run,
# change the password from admin.html's "Forgot password?" link, not by editing these — the
# database record is what actually controls login from then on, not these env vars.
ADMIN_USERNAME=biomexadmin
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_EMAIL=you@example.com

# ===== Email fallback for password reset (Gmail SMTP) =====
# Optional but recommended — WhatsApp reset codes only reach patients/doctors who've
# messaged Biomexa's WhatsApp number recently (MSG91 requires an open 24h session before it
# can free-text someone). Email works for anyone with an email on file, so it's the reliable
# fallback.
# 1. Use a Gmail account (e.g. biomexapharmaceuticals@gmail.com).
# 2. Turn on 2-Step Verification: https://myaccount.google.com/security
# 3. Generate an App Password: https://myaccount.google.com/apppasswords
#    (NOT your normal Gmail password — Google blocks that for security.)
EMAIL_USER=
EMAIL_APP_PASSWORD=

# ===== AI Engine (ai_engine.py — real drug-effectiveness analysis) =====
# This repo includes a genuine Python/Flask AI engine (ai_engine.py) that does vital-sign
# trend analysis, adherence scoring, symptom tracking, and generates clinical insights +
# treatment recommendations. It's a SEPARATE service from this Node backend — it does not
# run automatically when you deploy server.js.
#
# To actually turn it on:
# 1. Deploy ai_engine.py as its own Render "Web Service" (or any Python host):
#    - Runtime: Python 3
#    - Build command: pip install -r requirements.txt
#    - Start command: python ai_engine.py   (or, for production: gunicorn ai_engine:app)
# 2. Copy that service's URL (e.g. https://biomexa-ai-engine.onrender.com)
# 3. Set AI_ENGINE_URL below (on THIS Node service's environment variables, not the Python one)
#
# Until this is set, GET /api/doctor/patient/:phone/effectiveness will return a clear
# "not deployed yet" message rather than fabricating a result.
AI_ENGINE_URL=

# ===== MSG91 — two-way WhatsApp (dose confirm + vitals capture) =====
# This is Biomexa's sole WhatsApp provider — a real WhatsApp Business Solution Provider that
# supports quick-reply buttons and inbound webhooks, which is what makes "patient taps Taken,
# then texts their BP" possible. Without this set, NO WhatsApp messages go out at all.
#
# Setup steps:
# 1. Sign up at https://control.msg91.com and get WhatsApp Business API access
#    (Settings → WhatsApp in their dashboard — requires Meta Business verification).
# 2. Create a message template named "dose_reminder" with quick-reply buttons "Taken" /
#    "Not Taken" / "Remind Me Later", submit for Meta approval (usually 24-72h). Real body used:
#      "Time for your {{medicine_name}} dose ({{dosage}}). Did you take it?"
#    (named variables, not {{1}}/{{2}} — MSG91's builder requires named parameters)
# 3. Fill in the values below from your MSG91 dashboard (Settings → Authkey, and your template's
#    name/namespace/language once approved — namespace shows on the template's detail view).
# 4. In MSG91 → Settings → Webhooks, set the inbound WhatsApp webhook URL to:
#      https://<your-deployed-backend-url>/api/webhooks/msg91-whatsapp
#    (content type JSON — MSG91 lets you pick which fields to include; include at minimum the
#    sender's number, direction, content, and button fields)
#
# MSG91's exact webhook JSON field names can vary slightly by dashboard configuration — the
# webhook handler logs the raw payload it receives, so if replies aren't being recognized, check
# your server logs for the actual shape and adjust server.js's field lookups to match.
MSG91_AUTH_KEY=
MSG91_INTEGRATED_NUMBER=
MSG91_DOSE_TEMPLATE_NAME=dose_reminder
MSG91_TEMPLATE_NAMESPACE=
MSG91_TEMPLATE_LANG=en
